# Copy this file to .env.local and replace values for your environment.
# Do not commit real credentials.

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_platform
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=change_me_postgres

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# ---------- MongoDB ----------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=iot_readmodels
MONGO_USER=iot_mongo_user
MONGO_PASSWORD=change_me_mongo

# ---------- App ConnectionStrings ----------
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=iot_platform;Username=iot_user;Password=change_me_postgres
ConnectionStrings__Redis=redis:6379,password=change_me_redis,abortConnect=false
ConnectionStrings__Mongo=mongodb://iot_mongo_user:change_me_mongo@mongodb:27017/iot_readmodels?authSource=admin

# ---------- App Options ----------
EventStore__Schema=public
Projection__MongoDatabase=iot_readmodels
Cache__DefaultTtlSeconds=300
