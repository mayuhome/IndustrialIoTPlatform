# Server deployment template
# Use on the Linux server where Docker runs PostgreSQL / Redis / MongoDB.
# Keep the real file outside Git, e.g. .env.server.local

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_PORT=5433
POSTGRES_DB=iot_platform
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_password

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=change_me_password

# ---------- MongoDB ----------
MONGO_PORT=27017
MONGO_DB=iot_readmodels
MONGO_USER=change_me_user
MONGO_PASSWORD=change_me_password

# ---------- App ConnectionStrings ----------
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=iot_platform;Username=change_me_user;Password=change_me_password
ConnectionStrings__Redis=localhost:6379,password=change_me_password,abortConnect=false
# URL-encode reserved URI characters in Mongo username/password when needed.
ConnectionStrings__Mongo=mongodb://change_me_user:change_me_password@localhost:27017/iot_readmodels?authSource=admin

# ---------- App Options ----------
EventStore__Schema=public
Projection__MongoDatabase=iot_readmodels
Cache__DefaultTtlSeconds=300
